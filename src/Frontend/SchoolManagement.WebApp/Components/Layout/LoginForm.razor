@using SchoolManagement.Communication.RequestsDto
@using SchoolManagement.Communication.ResponsesDto
@using SchoolManagement.WebApp.Services.LoginService
@using Microsoft.JSInterop;

@inject ILoginService service
@inject IJSRuntime JS
@inject NotificationService NotificationService
@inject NavigationManager Navigation

<RadzenTemplateForm Data="@login"
                    Style="width: 100%"
                    TItem="RequestLoginDto"
                    Submit="@HandleSubmit">

    <ChildContent Context="formContext">

        <DataAnnotationsValidator />

        <div class="rz-m-4">
            <RadzenLabel Text="Email"
                         Component="Email"
                         Style="display: block" />

            <RadzenTextBox @bind-Value="login.Email"
                           Name="Email"
                           Placeholder="exemplo@email.com"
                           Style="width:100%" />

            <RadzenRequiredValidator Component="Email"
                                     Text="E-mail é obrigatório" />

            <RadzenEmailValidator Component="Email"
                                  Text="E-mail inválido" />
        </div>

        <div class="rz-m-4">

            <RadzenLabel Text="Senha"
                         Component="Senha"
                         Style="display: block" />

            <RadzenPassword @bind-Value="login.Senha"
                            Name="Senha"
                            Placeholder="******"
                            Style="width:100%" />

            <RadzenRequiredValidator Component="Senha"
                                     Text="Senha é obrigatória" />
        </div>

        <div class="rz-display-flex flex-column rz-gap-4 rz-m-4 m-4">

            <RadzenButton Text="Entrar"
                          ButtonType="ButtonType.Submit"
                          ButtonStyle="ButtonStyle.Primary"
                          Style="width: 100%"
                          />

            <RadzenStack AlignItems="AlignItems.Center" class="p-3">
                <RadzenText TextStyle="TextStyle.Body2">
                    Novo por aqui?
                    <RadzenLink Path="register" Text="Crie uma conta" Style="font-weight: bold" />
                </RadzenText>
            </RadzenStack>

        </div>

    </ChildContent>

</RadzenTemplateForm>

@code {

    private RequestLoginDto login = new();

    [Parameter]
    public EventCallback OnLoginSuccess { get; set; }

    private async Task HandleSubmit(RequestLoginDto loginDto)
    {
        var response = await service.Login(loginDto);

        if (response?.Tokens.AcessToken != null)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Bem-vindo",
                Detail = $"Olá, {response.Nome}! Login realizado com sucesso.",
                Duration = 3000
            });

            await JS.InvokeVoidAsync("setCookie", "authToken", response.Tokens.AcessToken, 60);

          
            await InvokeAsync(StateHasChanged);
            await Task.Delay(50);
            Navigation.NavigateTo("/dashboard", true);
        }
        else
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Erro de Autenticação",
                Detail = "E-mail ou senha incorretos."
            });
        }
    }
}