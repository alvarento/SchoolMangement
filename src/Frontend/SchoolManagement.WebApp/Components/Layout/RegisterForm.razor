@using SchoolManagement.Communication.RequestsDto
@using SchoolManagement.WebApp.Services.LoginService
@inject ILoginService service
@inject NotificationService NotificationService
@inject NavigationManager Navigation

<RadzenTemplateForm Data="@novoUsuario" TItem="RequestCreateUsuarioDto" Submit="@HandleRegister">
    <div class="rz-p-4">
        <div class="mb-3">
            <RadzenLabel Text="Nome Completo" Component="Nome" />
            <RadzenTextBox @bind-Value="novoUsuario.Nome" Name="Nome" Style="width:100%" />
            <RadzenRequiredValidator Component="Nome" Text="Nome é obrigatório" />
        </div>

        <div class="mb-3">
            <RadzenLabel Text="Email" Component="Email" />
            <RadzenTextBox @bind-Value="novoUsuario.Email" Name="Email" Style="width:100%" />
            <RadzenRequiredValidator Component="Email" Text="Email é obrigatório" />
            <RadzenEmailValidator Component="Email" Text="Formato de email inválido" />
        </div>

        <div class="row">
            <div class="col-6 mb-3">
                <RadzenLabel Text="Senha"/>
                <RadzenFormField Variant="Variant.Outlined" Style="width: 100%;">
                    <ChildContent>
                        @if (isPasswordVisible)
                        {
                            <RadzenTextBox Name="Senha" @bind-Value="@novoUsuario.Senha" />
                        }
                        else
                        {
                            <RadzenPassword Name="Senha" @bind-Value="@novoUsuario.Senha" />
                        }
                    </ChildContent>
                    <End>
                        <RadzenIcon Icon="@(isPasswordVisible ? "visibility" : "visibility_off")"
                                    Style="cursor: pointer;"
                                    @onclick="TogglePasswordVisibility" />
                    </End>
                </RadzenFormField>
                <RadzenRequiredValidator Component="Senha" Text="Senha é obrigatória" />
                <RadzenLengthValidator Component="Senha" Min="6" Max="10"
                                       Text="A senha deve ter entre 6 e 10 caracteres" />

                <RadzenRegexValidator Component="Senha" Text="A senha deve conter uma letra maiúscula e um número"
                                      Pattern="^(?=.*[A-Z])(?=.*\d).+$" />
            </div>
            <div class="col-6 mb-3">
                <RadzenLabel Text="Confirmar Senha" Component="ConfirmarSenha" />
                <RadzenFormField Variant="Variant.Outlined" Style="width: 100%;">
                <RadzenPassword @bind-Value="confirmarSenha" Name="ConfirmarSenha" Style="width:100%" />
                </RadzenFormField>
                <RadzenCompareValidator Value="@novoUsuario.Senha" Component="ConfirmarSenha" Text="As senhas não coincidem" />
            </div>
        </div>

        @if (PodeDefinirAdmin)
        {
            <div class="mb-3 rz-display-flex rz-align-items-center rz-gap-2">
                <RadzenCheckBox @bind-Value="novoUsuario.IsAdmin" Name="IsAdmin" TValue="bool" />
                <RadzenLabel Text="Usuário Administrador" Component="IsAdmin" />
            </div>
        }

        <div class="rz-display-flex rz-justify-content-center">
            <RadzenButton class="m-2" Text="Criar Conta" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" />
            <RadzenButton class="m-2" Text="Voltar" Click="@(() => Navigation.NavigateTo("/login"))" ButtonStyle="ButtonStyle.Light" />
        </div>
    </div>
</RadzenTemplateForm>

@code {
    private RequestCreateUsuarioDto novoUsuario = new();
    private string confirmarSenha = "";

    [Parameter] public bool PodeDefinirAdmin { get; set; } = false;

    private async Task HandleRegister()
    {
        var sucesso = await service.RegisterAsync(novoUsuario);

        if (sucesso)
        {
            NotificationService.Notify(NotificationSeverity.Success, "Sucesso", "Conta criada com sucesso! Faça login.");
            Navigation.NavigateTo("/login");
        }
        else
        {
            NotificationService.Notify(NotificationSeverity.Error, "Erro", "Não foi possível criar a conta.");
        }
    }


    bool isPasswordVisible = false;

    void TogglePasswordVisibility()
    {
        isPasswordVisible = !isPasswordVisible;
    }
}