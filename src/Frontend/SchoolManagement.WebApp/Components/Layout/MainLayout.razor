@inherits LayoutComponentBase

@using Microsoft.AspNetCore.Components.Authorization
@using SchoolManagement.WebApp.Services.AuthStateService

<RadzenComponents />

<RadzenLayout>

    <RadzenHeader>

        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     JustifyContent="JustifyContent.SpaceBetween"
                     Class="rz-px-4 rz-py-2">

            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         Gap="1rem">

                <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />

                <RadzenText TextStyle="TextStyle.H6"
                            Class="rz-m-0">

                    School Management

                </RadzenText>

            </RadzenStack>

            <AuthorizeView>

                <Authorized>

                    <RadzenStack Orientation="Orientation.Horizontal"
                                 AlignItems="AlignItems.Center"
                                 Gap="1rem">

                        <RadzenText TextStyle="TextStyle.Body2"
                                    Class="rz-m-0">

                            Olá,
                            <b>@context.User.Identity?.Name</b>

                        </RadzenText>

                        <RadzenButton Icon="logout"
                                      Text="Sair"
                                      ButtonStyle="ButtonStyle.Light"
                                      Size="ButtonSize.Small"
                                      Click="Logout" />

                    </RadzenStack>

                </Authorized>

            </AuthorizeView>

        </RadzenStack>

    </RadzenHeader>

    <RadzenSidebar @bind-Expanded="@sidebarExpanded">

        <RadzenStack Class="rz-py-4">
            <NavMenu />
        </RadzenStack>

    </RadzenSidebar>

    <RadzenBody>

        <div class="">
            @Body
        </div>

    </RadzenBody>

    <RadzenFooter>

        <RadzenText TextStyle="TextStyle.Caption"
                    Class="rz-text-align-center rz-p-2">

            School Management System © 2026

        </RadzenText>

    </RadzenFooter>

</RadzenLayout>

@code {

    private bool sidebarExpanded = true;

    [Inject]
    private IAuthStateService AuthStateService { get; set; } = default!;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private async Task Logout()
    {
        await AuthStateService.LogoutAsync();

        Navigation.NavigateTo("/login", true);
    }
}