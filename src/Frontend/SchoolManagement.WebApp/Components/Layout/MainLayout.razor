@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<RadzenComponents />

<RadzenLayout Style="grid-template-areas: 'rz-header rz-header' 'rz-sidebar rz-body';">
    
    @* Cabeçalho Superior *@
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Class="rz-px-4 rz-py-2">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />
                <RadzenText TextStyle="TextStyle.H6" Class="rz-m-0">School Management</RadzenText>
            </RadzenStack>

            @* Lado Direito: Nome do Usuário e Botão Sair *@
            <AuthorizeView>
                <Authorized>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                        <RadzenText TextStyle="TextStyle.Body2" Class="rz-m-0">Olá, <b>@context.User.Identity?.Name</b></RadzenText>
                        <RadzenButton Icon="logout" Text="Sair" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                      Click="Logout" />
                    </RadzenStack>
                </Authorized>
            </AuthorizeView>
        </RadzenStack>
    </RadzenHeader>

    @* Menu Lateral *@
    <RadzenSidebar @bind-Expanded="@sidebarExpanded">
        <RadzenStack Class="rz-py-4">
            <NavMenu />
        </RadzenStack>
    </RadzenSidebar>

    @* Corpo da Página *@
    <RadzenBody>
        <div class="rz-p-4">
            @Body
        </div>
    </RadzenBody>

    @* Rodapé (Opcional) *@
    <RadzenFooter>
        <RadzenText TextStyle="TextStyle.Caption" Class="rz-text-align-center rz-p-2">
            School Management System © 2026
        </RadzenText>
    </RadzenFooter>

</RadzenLayout>

@code {
    bool sidebarExpanded = true;

    [Inject] private SchoolManagement.WebApp.Services.AuthStateService.AuthStateService AuthStateService { get; set; } = default!;
    [Inject] private SchoolManagement.WebApp.Services.LocalStorageService.ILocalStorageService LocalStorage { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private async Task Logout()
    {
        await LocalStorage.RemoveItemAsync("authToken");
        AuthStateService.NotifyLogout();
        Navigation.NavigateTo("/");
    }
}