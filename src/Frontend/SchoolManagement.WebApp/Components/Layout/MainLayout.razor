@inherits LayoutComponentBase

@using SchoolManagement.Communication.ResponsesDto
@using Microsoft.AspNetCore.Components.Authorization
@using SchoolManagement.WebApp.Services.AuthStateService
@using SchoolManagement.WebApp.Services.UsuarioService
@inject IAuthStateService AuthState
@inject IUsuarioService UsuarioService

<RadzenComponents />

<RadzenLayout>

    <RadzenHeader>

        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     JustifyContent="JustifyContent.SpaceBetween"
                     Class="rz-px-4 rz-py-2">

            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         Gap="1rem">

                <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />

                <RadzenText TextStyle="TextStyle.H6"
                            Class="rz-m-0 text-light">

                    School Management

                </RadzenText>

            </RadzenStack>

            <AuthorizeView>

                <Authorized>

                    <RadzenStack Orientation="Orientation.Horizontal"
                                 AlignItems="AlignItems.Center"
                                 Gap="1rem">

                        <RadzenText TextStyle="TextStyle.Body2"
                                    Class="rz-m-0 text-light">

                            Olá,
                            <b>@(_usuarioNome)</b>

                        </RadzenText>

                        <RadzenButton Icon="logout"
                                      Text="Sair"
                                      ButtonStyle="ButtonStyle.Light"
                                      Size="ButtonSize.Small"
                                      Click="Logout" />

                    </RadzenStack>

                </Authorized>

            </AuthorizeView>

        </RadzenStack>

    </RadzenHeader>

    <RadzenSidebar @bind-Expanded="@sidebarExpanded">

        <RadzenStack Class="rz-py-4">
            <NavMenu />
        </RadzenStack>

    </RadzenSidebar>

    <RadzenBody>

        <div class="">
            @Body
        </div>

    </RadzenBody>

    <RadzenFooter>

        <RadzenText TextStyle="TextStyle.Caption"
                    Class="rz-text-align-center rz-p-2">

            School Management System © 2026

        </RadzenText>

    </RadzenFooter>

</RadzenLayout>

@code {

    private bool sidebarExpanded = true;
    private string _usuarioNome = "";

    [Inject]
    private IAuthStateService AuthStateService { get; set; } = default!;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Guid? userId = AuthState.GetUserId();

        if (userId.HasValue && userId != null)
        {
            // Agora você envia esse Guid para o seu AlunoService ou UsuarioService
            // para buscar o resto das informações no banco de dados.
            var usuario = await UsuarioService.GetById(userId.Value);
            if (usuario != null) _usuarioNome = usuario.Nome.Split(" ")[0];
        }
    }

    private async Task Logout()
    {
        await AuthStateService.LogoutAsync();

        Navigation.NavigateTo("/login", true);
    }


}