@page "/register"
@* @layout EmptyLayout *@

<div class="register-wrapper">
    <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Style="min-height: 100vh; padding: 2rem;">
        
        <RadzenCard Variant="Variant.Flat" Class="register-card rz-shadow-10">
            <RadzenStack Gap="1.5rem">
                
                @* Cabeçalho da Página *@
                <RadzenStack AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="account_circle" Style="font-size: 3rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" Class="rz-m-0 rz-text-align-center" Style="font-weight: 700;">
                        Criar Nova Conta
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Subtitle1" Class="rz-text-align-center" Style="color: var(--rz-text-secondary-color);">
                        Preencha os dados abaixo para acessar a plataforma School Management.
                    </RadzenText>
                </RadzenStack>

                <hr class="register-divider" />

                @* O Formulário que criamos anteriormente *@
                <RegisterForm PodeDefinirAdmin="false" />

                @* Rodapé com link de retorno *@
                <RadzenStack AlignItems="AlignItems.Center" Class="rz-mt-4">
                    <RadzenText TextStyle="TextStyle.Body2">
                        Já possui uma conta? 
                        <RadzenLink Path="login" Text="Fazer Login" Style="font-weight: bold; color: var(--rz-primary);" />
                    </RadzenText>
                </RadzenStack>

            </RadzenStack>
        </RadzenCard>

        @* Branding / Copyright sutil *@
        <RadzenText TextStyle="TextStyle.Caption" Class="rz-mt-4" Style="color: rgba(255,255,255,0.7);">
            &copy; 2024 School Management System. Todos os direitos reservados.
        </RadzenText>

    </RadzenStack>
</div>

<style>
    /* Fundo Moderno com Gradiente e formas abstratas (Estilo Consultoria) */
    .register-wrapper {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        background-attachment: fixed;
        position: relative;
        overflow: hidden;
    }

    /* Efeito de "Blur" no fundo para profundidade */
    .register-wrapper::before {
        content: "";
        position: absolute;
        width: 300px;
        height: 300px;
        background: var(--rz-primary);
        filter: blur(120px);
        border-radius: 50%;
        top: -100px;
        right: -100px;
        opacity: 0.15;
    }

    /* Card customizado */
    .register-card {
        max-width: 550px;
        width: 100%;
        border-radius: 1.5rem;
        background-color: #ffffff;
        padding: 2.5rem !important;
        border: 1px solid rgba(0,0,0,0.05);
    }

    .register-divider {
        border: 0;
        height: 1px;
        background: linear-gradient(to right, transparent, rgba(0,0,0,0.1), transparent);
        margin: 0;
    }

    /* Ajuste para telas pequenas */
    @@media (max-width: 768px) {
        .register-card {
            padding: 1.5rem !important;
        }
    }
</style>