@page "/dashboard"

<RadzenStack Gap="1rem" Class="rz-p-4">
    <RadzenText TextStyle="TextStyle.H4" Style="font-weight: bold;">Dashboard Administrativo</RadzenText>
    
    <RadzenRow>
        @* Card de Exemplo: Total de Alunos *@
        <RadzenColumn Size="12" SizeMD="4">
            <RadzenCard Variant="Variant.Flat" Style="background-color: var(--rz-primary-lighter); border-left: 5px solid var(--rz-primary);">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                    <RadzenIcon Icon="people" Style="font-size: 2.5rem; color: var(--rz-primary);" />
                    <RadzenStack Gap="0">
                        <RadzenText TextStyle="TextStyle.Subtitle2" Class="rz-m-0">Total de Alunos</RadzenText>
                        <RadzenText TextStyle="TextStyle.H4" Class="rz-m-0" Style="font-weight: bold;">1,250</RadzenText>
                    </RadzenStack>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>

        @* Card de Exemplo: Turmas Ativas *@
        <RadzenColumn Size="12" SizeMD="4">
            <RadzenCard Variant="Variant.Flat" Style="background-color: #e3f2fd; border-left: 5px solid #2196f3;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                    <RadzenIcon Icon="class" Style="font-size: 2.5rem; color: #2196f3;" />
                    <RadzenStack Gap="0">
                        <RadzenText TextStyle="TextStyle.Subtitle2" Class="rz-m-0">Turmas Ativas</RadzenText>
                        <RadzenText TextStyle="TextStyle.H4" Class="rz-m-0" Style="font-weight: bold;">48</RadzenText>
                    </RadzenStack>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>

    <RadzenCard Class="rz-mt-4">
        <RadzenText TextStyle="TextStyle.H6">Bem-vindo ao painel de controle!</RadzenText>
        <RadzenText TextStyle="TextStyle.Body1">
            Utilize o menu lateral para gerenciar alunos, professores e configurações do sistema.
        </RadzenText>
    </RadzenCard>
</RadzenStack>