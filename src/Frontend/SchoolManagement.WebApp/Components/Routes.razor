@using Microsoft.AspNetCore.Components.Authorization

<CascadingAuthenticationState>
<Router AppAssembly="@typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            @* 2. AuthorizeRouteView verifica o atributo [Authorize] nas páginas *@
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                
                @* Caso o usuário tente acessar uma página [Authorize] e não esteja logado *@
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        @* Caso ele esteja logado mas não tenha permissão (ex: não é Admin) *@
                        <p role="alert">Você não tem permissão para acessar esta página.</p>
                    }
                </NotAuthorized>

                @* Caso ele não tenha permissão mas o Blazor ainda esteja validando *@
                <Authorizing>
                    <p>Validando autenticação...</p>
                </Authorizing>

            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
</Router>
</CascadingAuthenticationState>
