@page "/"
@layout EmptyLayout

<RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Style="min-height: 100vh; background: linear-gradient(180deg, #ffffff 0%, #f0f4f8 100%);">
    
    @* Seção de Hero *@
    <RadzenStack Gap="2rem" Class="rz-p-12 rz-text-align-center" Style="max-width: 900px;">
        <RadzenIcon Icon="school" Style="font-size: 5rem; color: var(--rz-primary);" />
        
        <RadzenStack Gap="0.5rem">
            <RadzenText TextStyle="TextStyle.H2" TagName="TagName.H1" Style="font-weight: 800; color: #1a202c;">
                School Management System
            </RadzenText>
            <RadzenText TextStyle="TextStyle.H5" Style="color: #4a5568; line-height: 1.6;">
                A solução definitiva para gestão acadêmica, controle de alunos e eficiência administrativa.
                Desenvolvido pela <strong>SuaEmpresa Tech</strong>.
            </RadzenText>
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="1.5rem">
            <RadzenButton Text="Acessar Sistema" Icon="login" ButtonStyle="ButtonStyle.Primary"
                          Size="ButtonSize.Large" Click="@(() => Nav.NavigateTo("login"))"
                          Style="border-radius: 8px; padding: 0 2rem;" />
            
            <RadzenButton Text="Conhecer Empresa" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Secondary"
                          Size="ButtonSize.Large" Style="border-radius: 8px;" />
        </RadzenStack>
    </RadzenStack>

    @* Rodapé Simples *@
    <RadzenText TextStyle="TextStyle.Caption" Style="position: absolute; bottom: 20px; color: #a0aec0;">
        &copy; 2026 SuaEmpresa Tech - Todos os direitos reservados.
    </RadzenText>
</RadzenStack>

@inject NavigationManager Nav